# loop-enginner — referencia de configuracao (este arquivo NAO e lido)
#
# O loop le variaveis de ambiente. Para usar, exporte no shell antes do run
# ou copie as linhas uteis para o seu wrapper local. Flags tem prioridade
# sobre variaveis quando as duas existem (--test-cmd > LOOP_ENGINNER_TEST_CMD).

# Gate 2: comando de teste do projeto. Sem ele, o loop detecta pelo manifest
# (Sail/composer/artisan/package.json/pytest/go/cargo) ou pula o gate.
#LOOP_ENGINNER_TEST_CMD="npm test"

# Gate 3: verificacao independente. always (default) | auto | off
#LOOP_ENGINNER_VERIFY=always

# Modelo do verificador no engine claude (default: sonnet)
#LOOP_ENGINNER_VERIFY_MODEL=sonnet

# Ciclos de correcao por fase antes de declarar falha (default: 3)
#LOOP_ENGINNER_MAX_CYCLES=3

# Resiliencia a limite de uso da engine
#LOOP_ENGINNER_MAX_LIMIT_WAITS=20
#LOOP_ENGINNER_LIMIT_WAIT_DEFAULT=1800
#LOOP_ENGINNER_LIMIT_BUFFER=60

# Hook de eventos (default: ./.loop-enginner/hook.sh se executavel)
#LOOP_ENGINNER_HOOK=/caminho/para/hook.sh

# Metadados exibidos no painel quando a engine e o codex (so exibicao;
# quem define modelo/profile de verdade e a configuracao da propria CLI)
#LOOP_ENGINNER_CODEX_MODEL=gpt-5.6-luna
#LOOP_ENGINNER_CODEX_PROFILE=meu-profile
#LOOP_ENGINNER_CODEX_REASONING_EFFORT=high

# Adapter Antigravity (--engine agy)
#LOOP_ENGINNER_AGY_BIN=agy
#LOOP_ENGINNER_AGY_MODEL=
#LOOP_ENGINNER_AGY_EFFORT=high
#LOOP_ENGINNER_AGY_PRINT_TIMEOUT=30m
#LOOP_ENGINNER_AGY_INACTIVITY_TIMEOUT=30m

# Adapter OpenCode (--engine opencode)
#LOOP_ENGINNER_OPENCODE_BIN=opencode
#LOOP_ENGINNER_OPENCODE_MODEL=
#LOOP_ENGINNER_OPENCODE_VARIANT=
#LOOP_ENGINNER_OPENCODE_AGENT=
#LOOP_ENGINNER_OPENCODE_VERIFY_AGENT=plan
#LOOP_ENGINNER_OPENCODE_INACTIVITY_TIMEOUT=900s

# Painel (loop-enginner watch): fixa dimensoes em pipe/teste
#LOOP_ENGINNER_WATCH_COLS=120
#LOOP_ENGINNER_WATCH_LINES=40
